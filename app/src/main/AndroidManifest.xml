<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮小窗：半透明悬浮球常驻屏幕边缘 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".App"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeepSeekApiLauncher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DeepSeekApiLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Qwen 浏览器登录页：独立原生 Activity（结构对齐 base-2.apk），
             configChanges 防旋转重建导致 WebView 反复销毁 -->
        <activity
            android:name=".ui.login.QwenLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
        <!-- DeepSeek 登录页：独立原生 Activity（结构对齐 base-2.apk 的 LoginActivity） -->
        <activity
            android:name=".ui.login.DeepSeekLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
        <service
            android:name=".service.ApiService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".service.FloatingService"
            android:exported="false" />
    </application>

</manifest>
